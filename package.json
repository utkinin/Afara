{
  "name": "afara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --env-file-if-exists=.env.local --test --test-force-exit tests/*.test.ts",
    "test:e2e": "playwright test",
    "payload": "tsx --env-file-if-exists=.env.local node_modules/payload/bin.js",
    "generate:types": "npm run payload -- generate:types",
    "generate:importmap": "npm run payload -- generate:importmap",
    "db:migrate": "npm run payload -- migrate",
    "db:migrate:create": "npm run payload -- migrate:create",
    "seed:dev": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "create:admin": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "graphql": "16.11.0",
    "jose": "6.2.12",
    "next": "16.4.1",
    "nodemailer": "10.1.1",
    "payload": "3.90.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.5",
    "zod": "4.3.6",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "$sharp",
    "nodemailer": "$nodemailer",
    "undici": "7.29.1",
    "dompurify": "3.4.16",
    "sass": "1.105.1"
  }
}
