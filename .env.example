DATABASE_URL=postgresql://postgres@127.0.0.1:5432/afara
# Generate a unique value with: openssl rand -hex 32
PAYLOAD_SECRET=
APP_URL=http://localhost:3000
AFARA_STAGE=development
MEDIA_DIR=./media
# Optional local SMTP. Production requires an authenticated TLS SMTP service.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=

# Apply checked migrations explicitly; avoid automatic schema pushes on retained CMS data.
AFARA_DB_PUSH=false
# Server-only optional consultant. No provider request until BOTH flag and key are supplied.
AFARA_AI_ENABLED=false
AFARA_AI_MODEL=gpt-4.1-mini
AFARA_AI_API_KEY=
AFARA_AI_DAILY_LIMIT=100
