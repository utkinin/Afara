# PRIVATE: copy to ../.env.production, chmod 600, never commit the filled file.
# Set passwords/secrets on the server, not in chat. Hex secrets need no URL escaping.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://afara:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/afara
PAYLOAD_SECRET=
APP_URL=https://REPLACE_WITH_DOMAIN
AFARA_PUBLIC_URL=https://REPLACE_WITH_DOMAIN
AFARA_STAGE=production
AFARA_DB_PUSH=false
MEDIA_DIR=/app/media

# Authenticated SMTP; 587 = STARTTLS, 465 = implicit TLS. Use a real sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Cloudflare Access, with an IdP requiring MFA. No https:// in TEAM_DOMAIN.
ACCESS_TEAM_DOMAIN=
ACCESS_AUDIENCE=

# Approved-source search works without an external model key.
AFARA_AI_ENABLED=false
AFARA_AI_MODEL=gpt-4.1-mini
AFARA_AI_API_KEY=
AFARA_AI_DAILY_LIMIT=100
ANALYTICS_TRUST_CLOUDFLARE=false
